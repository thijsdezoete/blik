#: templates/emails/onboarding_invite_reviewers.html:9
#: templates/emails/onboarding_invite_reviewers.txt:5
msgid ""
"Reviewers who get the link early have more time to answer. More answers make"
" the report more complete."
msgstr ""
"I revisori che ricevono il link in anticipo hanno più tempo per rispondere. "
"Più risposte rendono il rapporto più completo."

#: templates/emails/onboarding_invite_reviewers.html:10
#: templates/emails/onboarding_invite_reviewers.txt:7
msgid "Invite them in one of two ways:"
msgstr "Invitali in uno dei due modi:"

#: templates/emails/onboarding_invite_reviewers.html:12
msgid "<strong>By email.</strong> Blik sends each reviewer a personal link."
msgstr ""
"<strong>Via email.</strong> Blik invia a ogni recensore un link personale."

#: templates/emails/onboarding_invite_reviewers.html:13
