#, python-format
msgid ""
"You have undone the cancellation. %(organization)s keeps the %(plan)s plan, "
"and nothing else changes."
msgstr ""
"Vous avez annulé l’annulation. %(organization)s garde le plan %(plan)s , et "
"rien d’autre ne change."

