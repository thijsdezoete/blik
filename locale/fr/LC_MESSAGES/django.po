#, python-format
msgid ""
"Thank you. %(organization)s is now on the paid %(plan)s plan. All your "
"review cycles, reports and settings are in place."
msgstr ""
"Merci. %(organization)s est maintenant sur le plan %(plan)s payant. Tous vos"
" cycles de révision, rapports et paramètres sont en place."

#: templates/emails/partials/subscription_confirmed_next_step.txt:1
msgid "Next step: follow up your open cycles"
msgstr "Étape suivante : faire un suivi de vos cycles ouverts"

