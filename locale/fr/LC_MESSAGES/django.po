#: templates/emails/partials/subscription_confirmed_intro.txt:1
#, python-format
msgid ""
"Thank you for choosing %(site_name)s for %(organization)s. Your free trial "
"of the %(plan)s plan runs until %(date)s. We charge nothing before that "
"date, and we remind you before the trial ends."
